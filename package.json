{
  "name": "vue-zero-admin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host",
    "build": "vp build",
    "build:prod": "vp build --mode production",
    "build:test": "vp build --mode test",
    "build:dev": "vp build --mode development",
    "preview": "vp preview",
    "build-only": "vp build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "npx oxlint --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "vp fmt src/",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "element-plus": "^2.14.5",
    "es-toolkit": "^1.52.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@intlify/core-base": "^11.4.10",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.62.1",
    "@tsconfig/node20": "^20.1.10",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/three": "^0.185.4",
    "@types/w3c-web-hid": "^1.0.7",
    "@unocss/preset-attributify": "^66.8.1",
    "@unocss/preset-rem-to-px": "^66.8.1",
    "@unocss/preset-wind4": "^66.8.1",
    "@unocss/transformer-directives": "^66.8.1",
    "@unocss/transformer-variant-group": "^66.8.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.103.1",
    "typescript": "^6.0.3",
    "unocss": "^66.8.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-oxlint": "^2.1.2",
    "vite-plugin-pages": "^0.33.3",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "^0.2.9",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,astro,svelte}": "oxlint"
  },
  "types": "./types/index.d.ts",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "download"
    }
  }
}
