{
  "extends": "./tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "src/**/*.json", "src/**/*.vue"],
  "exclude": ["**/node_modules/*", "node_modules", "**/*.test.ts", "**/test/**/*"],
  "compilerOptions": {
    "composite": true,
    "skipDefaultLibCheck": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "jsx": "preserve",
    "noEmit": true,
    "noImplicitAny": false,
    "types": ["primevue/config", "@intlify/unplugin-vue-i18n/messages", "@types/w3c-web-hid"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator", "ESNext.Promise"],
    "target": "es2024",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
